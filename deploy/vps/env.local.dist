# api/.env.local on the VPS (docs/DEPLOY_VPS.md). Written once by setup.sh, which fills every
# <generated> value (database passwords, secrets); fill the remaining <…> by hand. Never in git.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<generated>

# The API's own address (links built outside a request) and the SPA's (links in emails, and the
# only CORS origin, compared exactly: CORS_ALLOWED_ORIGIN defaults to it in api/.env).
DEFAULT_URI=https://api.<domain>
FRONTEND_URL=https://www.<domain>

# The three databases on the local MySQL 8.4 (docs/DEPLOY_OVH.md, § 3), one user each.
DATABASE_URL=<generated>
CATALOG_DATABASE_URL=<generated>
ENDGAME_DATABASE_URL=<generated>
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# The local Postfix (send-only, DKIM-signed by OpenDKIM): the sender must be an address of the domain.
MAILER_DSN=sendmail://default
MAILER_FROM_ADDRESS=no-reply@<domain>

# JWT: keys generated on the server (`bin/console lexik:jwt:generate-keypair`), with this passphrase.
JWT_PASSPHRASE=<generated>
REFRESH_COOKIE_SECURE=1

# OAuth: the redirect URIs registered with Google, character for character.
OAUTH_GOOGLE_CLIENT_ID=<…>
OAUTH_GOOGLE_CLIENT_SECRET=<…>
OAUTH_GOOGLE_REDIRECT_URI=https://api.<domain>/api/auth/oauth/google/callback
OAUTH_LICHESS_CLIENT_ID=dontstayrooky
OAUTH_LICHESS_REDIRECT_URI=https://api.<domain>/api/auth/oauth/lichess/callback
OAUTH_TOKEN_ENCRYPTION_KEY=<generated>
LICHESS_APP_TOKEN=

# Web Push (`bin/console app:notification:vapid-keys`, once) and the calendar feed.
VAPID_PUBLIC_KEY=<…>
VAPID_PRIVATE_KEY=<…>
VAPID_SUBJECT=mailto:no-reply@<domain>
CALENDAR_TOKEN_KEY=<generated>

# A worker and the system cron consume the queues: no tick, no drain after each request. The token
# still guards GET /api/ops/check.
OPS_TICK_TOKEN=<generated>
OPS_DRAIN_ON_TERMINATE=0
