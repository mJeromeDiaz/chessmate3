# MySQL 8.4 on the VPS (docs/DEPLOY_VPS.md), sized for 4 GB of RAM: the catalogue (~650 MB) and the
# main base fit in the buffer pool. Local connections only.
# Installed by setup.sh as /etc/mysql/mysql.conf.d/90-dontstayrooky.cnf.
[mysqld]
bind-address = 127.0.0.1
mysqlx = OFF
skip-name-resolve
local_infile = OFF

innodb_buffer_pool_size = 1G
innodb_redo_log_capacity = 512M
max_connections = 60
