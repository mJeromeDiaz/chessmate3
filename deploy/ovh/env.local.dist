# api/.env.local on the OVH shared host (docs/DEPLOY_OVH.md). Copy it there once (never in git),
# fill every <…>, keep it out of the web root (it is: the web root is api/public).
# Secrets: generate them on your machine, e.g. `openssl rand -hex 32` / `openssl rand -base64 32`.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<openssl rand -hex 32>

# The API's own address (links built outside a request) and the SPA's (links in emails, CORS).
DEFAULT_URI=https://api.<domain>
FRONTEND_URL=https://app.<domain>
CORS_ALLOWED_ORIGIN=^https://app\.<domain>$

# Main database (OVH manager > Web Cloud > Hébergements > Bases de données). The puzzle catalogue
# moves to a second base later (docs/DEPLOY_OVH.md, § 3).
DATABASE_URL="mysql://<user>:<password>@<host>.mysql.db:3306/<base>?serverVersion=8.0.46&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# PHP mail() (App\Mailer\MailFunctionTransport): the sender must be an address of the domain.
MAILER_DSN=mailfunction://default
MAILER_FROM_ADDRESS=no-reply@<domain>

# JWT: keys generated on the server (`bin/console lexik:jwt:generate-keypair`), with this passphrase.
JWT_PASSPHRASE=<openssl rand -hex 32>
REFRESH_COOKIE_SECURE=1

# OAuth: the redirect URIs registered with Google, character for character.
OAUTH_GOOGLE_CLIENT_ID=<…>
OAUTH_GOOGLE_CLIENT_SECRET=<…>
OAUTH_GOOGLE_REDIRECT_URI=https://api.<domain>/api/auth/oauth/google/callback
OAUTH_LICHESS_CLIENT_ID=chessmate
OAUTH_LICHESS_REDIRECT_URI=https://api.<domain>/api/auth/oauth/lichess/callback
OAUTH_TOKEN_ENCRYPTION_KEY=<openssl rand -base64 32>
LICHESS_APP_TOKEN=<optional: token of the app's own Lichess account>

# Web Push (bin/console app:notification:vapid-keys) and the calendar feed.
VAPID_PUBLIC_KEY=<…>
VAPID_PRIVATE_KEY=<…>
VAPID_SUBJECT=mailto:no-reply@<domain>
CALENDAR_TOKEN_KEY=<openssl rand -base64 32>

# Hosting without worker: the tick's secret (also given to the external scheduler), and the drain
# of domain events after each write request.
OPS_TICK_TOKEN=<openssl rand -hex 32>
OPS_DRAIN_ON_TERMINATE=1

# Only if GET /api/ops/check shows the proxy's IP or http instead of https (docs/DEPLOY_OVH.md).
# SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
