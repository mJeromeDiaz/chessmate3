# Don't Stay Rooky SPA — build-time variables (read by quasar.config.js, baked into the bundle: never put a
# secret here).
#
# Base URL of the Symfony API, no trailing slash. Also added to the page's CSP (connect-src).
# Usage: API_URL=https://api.dontstayrooky.example npm run build
API_URL=http://localhost:8000
