# Apache (OVH shared hosting, docs/DEPLOY_OVH.md): the built SPA, static files only (hash router:
# no rewriting). index.html and the service worker are always revalidated; the hashed assets of a
# build never change, so they are cached for a year.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"

    <FilesMatch "^(index\.html|push-sw\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
