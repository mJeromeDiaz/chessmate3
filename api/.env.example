# Don't Stay Rooky API — every environment variable, documented.
#
# Copy the secret ones into .env.local (never committed) in development, or set them with Symfony
# Secrets in production (bin/console secrets:set NAME --env=prod). The committed .env only holds
# non-secret defaults and empty placeholders. See docs/SECURITY.md.

###> Symfony ###
APP_ENV=prod
# SECRET. 32+ random bytes (openssl rand -hex 32). Signs email-verification links and keys the HMAC
# of 2FA codes. Rotating it invalidates pending codes and unused verification links (SECURITY.md 4.3).
APP_SECRET=
APP_SHARE_DIR=var/share
# Base URL used when generating absolute URLs outside of a request (the email-verification link).
DEFAULT_URI=https://api.dontstayrooky.example
# Behind a reverse proxy: its address(es), so client IPs (rate limiting, audit log) are the real ones.
# SYMFONY_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< Symfony ###

###> Database (MySQL 8) ###
# SECRET (password).
DATABASE_URL="mysql://dontstayrooky:CHANGE_ME@127.0.0.1:3306/dontstayrooky?serverVersion=8.0.32&charset=utf8mb4"
CATALOG_DATABASE_URL="mysql://dontstayrooky:CHANGE_ME@127.0.0.1:3306/dontstayrooky_catalog?serverVersion=8.0.32&charset=utf8mb4"
###< Database ###

###> JWT (lexik) ###
# RSA key pair, generated with bin/console lexik:jwt:generate-keypair — never committed
# (config/jwt/*.pem is gitignored). Rotation: SECURITY.md 4.1.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# SECRET. Passphrase of the private key.
JWT_PASSPHRASE=
###< JWT ###

###> Sessions ###
# Refresh-token session: idle timeout and absolute lifetime, in seconds (7 and 30 days).
REFRESH_TOKEN_IDLE_TTL=604800
REFRESH_TOKEN_ABSOLUTE_TTL=2592000
# 1 = cookies only over HTTPS. Only ever 0 for local HTTP development.
REFRESH_COOKIE_SECURE=1
###< Sessions ###

###> Front-end / CORS ###
# The SPA's URL (no trailing slash): links in emails and redirects after OAuth.
FRONTEND_URL=https://app.dontstayrooky.example
# The single origin allowed to call the API with credentials, matched exactly (scheme://host[:port]).
CORS_ALLOWED_ORIGIN=${FRONTEND_URL}
###< Front-end / CORS ###

###> Mail ###
# SECRET (SMTP credentials). E.g. smtp://user:pass@smtp.example.com:587
MAILER_DSN=
MAILER_FROM_ADDRESS=no-reply@dontstayrooky.example
# Async transport for every email except the 2FA code (sent synchronously). Needs a supervised
# worker: bin/console messenger:consume async
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< Mail ###

###> OAuth ###
# Google (https://console.cloud.google.com/apis/credentials).
OAUTH_GOOGLE_CLIENT_ID=
# SECRET.
OAUTH_GOOGLE_CLIENT_SECRET=
# Must be registered with Google character for character.
OAUTH_GOOGLE_REDIRECT_URI=https://api.dontstayrooky.example/api/auth/oauth/google/callback
# Lichess: public client (PKCE, no secret, no registration). Any stable name, shown on the consent page.
OAUTH_LICHESS_CLIENT_ID=dontstayrooky
OAUTH_LICHESS_REDIRECT_URI=https://api.dontstayrooky.example/api/auth/oauth/lichess/callback
# SECRET. Encrypts the Lichess tokens kept in the database: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=
# SECRET. Only while rotating the key above: the key being replaced (SECURITY.md 4.2).
OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS=
###< OAuth ###

###> calendar feed ###
# SECRET. Encrypts the private calendar address tokens: openssl rand -base64 32
CALENDAR_TOKEN_KEY=
# SECRET. Only while rotating the key above: the key being replaced (SECURITY.md 4.2 bis).
CALENDAR_TOKEN_KEY_PREVIOUS=
###< calendar feed ###
