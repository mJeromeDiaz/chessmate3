{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'reset_password.requested'|trans({'%date%': requestedAt|date('d/m/Y'), '%time%': requestedAt|date('H:i'), '%device%': device, '%ip%': ip}) }}</p>
        <p>{{ 'reset_password_no_password.no_password'|trans({'%login%': '<a href="' ~ (frontendUrl ~ '/#/login')|e('html_attr') ~ '">' ~ 'reset_password_no_password.login'|trans|e ~ '</a>'})|raw }}</p>
        <p>{{ 'reset_password_no_password.add'|trans }}</p>
        <p>{{ 'ignore'|trans }}</p>
    </body>
</html>
