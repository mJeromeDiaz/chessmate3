{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'password_added.body'|trans({'%date%': addedAt|date('d/m/Y'), '%time%': addedAt|date('H:i'), '%device%': device, '%ip%': ip}) }}</p>
        <p><strong>{{ 'password_added.warning'|trans({
            '%reset%': '<a href="' ~ forgotPasswordUrl|e('html_attr') ~ '">' ~ 'password_added.reset'|trans|e ~ '</a>',
            '%profile%': '<a href="' ~ profileUrl|e('html_attr') ~ '">' ~ 'password_added.profile'|trans|e ~ '</a>',
        })|raw }}</strong></p>
    </body>
</html>
