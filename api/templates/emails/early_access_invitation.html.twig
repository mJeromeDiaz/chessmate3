{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'early_access_invitation.welcome'|trans({'%brand%': '<strong>Don\'t Stay Rooky</strong>'})|raw }}</p>
        <p>{{ 'early_access_invitation.personal'|trans }}</p>
        <p><a href="{{ url }}">{{ 'early_access_invitation.button'|trans }}</a></p>
        {% if expiresAt %}<p>{{ 'early_access_invitation.expires'|trans({'%date%': expiresAt|date('d/m/Y', false), '%time%': expiresAt|date('H:i', false), '%timezone%': timezone}) }}</p>{% endif %}
        <p style="color: #6e6a80; font-size: 13px;">{{ 'early_access_invitation.unexpected'|trans }}</p>
    </body>
</html>
