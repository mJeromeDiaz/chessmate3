{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'email_already_in_use.body'|trans({'%date%': attemptedAt|date('d/m/Y'), '%time%': attemptedAt|date('H:i')}) }}</p>
        <p>{{ 'email_already_in_use.advice'|trans({'%login%': '<a href="' ~ loginUrl|e('html_attr') ~ '">' ~ 'email_already_in_use.login'|trans|e ~ '</a>'})|raw }}</p>
    </body>
</html>
