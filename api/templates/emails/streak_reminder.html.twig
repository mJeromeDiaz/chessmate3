{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'streak_reminder.body'|trans({'%days%': '<strong>' ~ days|e ~ '</strong>'})|raw }}</p>
        <p><a href="{{ url }}">{{ 'streak_reminder.button'|trans }}</a></p>
        <p style="color: #6e6a80; font-size: 13px;">{{ 'streak_reminder.settings'|trans({'%profile%': '<a href="' ~ profileUrl|e('html_attr') ~ '">' ~ 'streak_reminder.profile'|trans|e ~ '</a>'})|raw }}</p>
    </body>
</html>
