{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'session_reminder.starts'|trans({'%title%': '<strong>' ~ title|e ~ '</strong>', '%when%': when|e, '%minutes%': totalMinutes})|raw }}</p>
        <ul>
            {% for step in steps %}<li>{{ step.label }} · {{ step.minutes }} min</li>{% endfor %}
        </ul>
        <p><a href="{{ url }}">{{ 'session_reminder.button'|trans }}</a></p>
        <p style="color: #6e6a80; font-size: 13px;">{{ 'session_reminder.unsubscribe'|trans }}</p>
    </body>
</html>
