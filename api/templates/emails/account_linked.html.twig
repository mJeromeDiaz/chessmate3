{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'account_linked.body'|trans({'%provider%': provider ~ (providerEmail ? ' (' ~ providerEmail ~ ')' : ''), '%date%': linkedAt|date('d/m/Y'), '%time%': linkedAt|date('H:i')}) }}</p>
        <p><strong>{{ 'account_linked.warning'|trans({'%profile%': '<a href="' ~ profileUrl|e('html_attr') ~ '">' ~ 'account_linked.profile'|trans|e ~ '</a>'})|raw }}</strong></p>
    </body>
</html>
