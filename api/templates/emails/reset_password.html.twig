{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'reset_password.requested'|trans({'%date%': requestedAt|date('d/m/Y'), '%time%': requestedAt|date('H:i'), '%device%': device, '%ip%': ip}) }}</p>
        <p><a href="{{ resetUrl }}">{{ 'reset_password.button'|trans }}</a></p>
        <p>{{ 'reset_password.expires'|trans({'%count%': expiresInMinutes}) }}</p>
        <p>{{ 'reset_password.ignore'|trans }}</p>
    </body>
</html>
