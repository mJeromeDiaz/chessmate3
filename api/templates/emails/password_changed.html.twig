{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'password_changed.body'|trans({'%date%': changedAt|date('d/m/Y'), '%time%': changedAt|date('H:i'), '%device%': device, '%ip%': ip}) }}</p>
        <p>{{ 'password_changed.sessions'|trans }}</p>
        <p><strong>{{ 'password_changed.warning'|trans }}</strong></p>
        <p><a href="{{ forgotPasswordUrl }}">{{ 'password_changed.button'|trans }}</a></p>
    </body>
</html>
