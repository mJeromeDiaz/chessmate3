{% trans_default_domain 'emails' %}
<!DOCTYPE html>
<html>
    <body style="font-family: sans-serif;">
        <p>{{ 'greeting'|trans }}</p>
        <p>{{ 'mfa_code.intro'|trans }}</p>
        <p style="font-size: 28px; font-weight: bold; letter-spacing: 4px;">{{ code }}</p>
        <p>{{ 'mfa_code.validity'|trans }}</p>
        <p>{{ 'mfa_code.requested'|trans({'%date%': requestedAt|date('d/m/Y'), '%time%': requestedAt|date('H:i'), '%device%': device, '%ip%': ip}) }}</p>
        <p><strong>{{ 'mfa_code.warning'|trans }}</strong></p>
    </body>
</html>
