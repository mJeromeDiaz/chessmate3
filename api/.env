# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.46&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# The one origin allowed to call the API with credentials, matched exactly (scheme + host + port,
# no path, no regex). Defaults to the SPA's URL, defined further down.
CORS_ALLOWED_ORIGIN=${FRONTEND_URL}
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Real value belongs in .env.local (gitignored) or Symfony secrets in production, never here.
# See docs/SECURITY.md for the key rotation procedure.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/refresh-token ###
# A session (refresh-token family) ends after REFRESH_TOKEN_IDLE_TTL seconds without a refresh
# (default: 7 days), and REFRESH_TOKEN_ABSOLUTE_TTL seconds after login no matter what (default:
# 30 days) — rotation never extends a session past its absolute lifetime.
REFRESH_TOKEN_IDLE_TTL=604800
REFRESH_TOKEN_ABSOLUTE_TTL=2592000
# Must be 1 (HTTPS only) everywhere except local HTTP dev — see .env.dev / .env.test.
REFRESH_COOKIE_SECURE=1
###< app/refresh-token ###

###> app/mail-frontend ###
MAILER_FROM_ADDRESS=no-reply@chessmate.example
# Base URL of the Vue SPA, used to build links in emails (verification, password reset, OAuth
# callback redirects). No trailing slash.
FRONTEND_URL=http://localhost:9000
###< app/mail-frontend ###

###> app/oauth ###
# Google OAuth client (https://console.cloud.google.com/apis/credentials). The secret goes in
# .env.local or Symfony secrets, never here.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Must match, character for character, an "Authorized redirect URI" registered with Google. Fixed
# here rather than derived from the request's Host header.
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# Lichess OAuth: a public client (PKCE, no secret, no app registration). The client id is any
# stable name; it is shown to the user on Lichess's consent page.
OAUTH_LICHESS_CLIENT_ID=chessmate
OAUTH_LICHESS_REDIRECT_URI=http://localhost:8000/api/auth/oauth/lichess/callback
# Key encrypting the provider access tokens we keep (Lichess), 32 random bytes in base64:
#   openssl rand -base64 32
# Set it in .env.local or Symfony secrets, never here. Rotation: see docs/SECURITY.md.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Only during a key rotation: the key being replaced (see docs/SECURITY.md).
OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS=
###< app/oauth ###

###> app/lichess ###
# Personal API token of the application's own Lichess account (no scope needed): used by the opening
# explorer proxy for users without a linked Lichess account. Set it in .env.local or Symfony secrets,
# never here. Empty: the explorer is only available to users with a linked Lichess account.
LICHESS_APP_TOKEN=
###< app/lichess ###

###> web push (docs/NOTIFICATIONS.md) ###
# VAPID keys: `bin/console app:notification:vapid-keys`, once per environment, then in .env.local
# (dev) or Symfony Secrets (prod). The private key is a secret. Empty: no browser notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@chessmate.example
###< web push ###

###> calendar feed (docs/TRAINING.md, calendar) ###
# Encrypts the private calendar address tokens: 32 random bytes, base64 (openssl rand -base64 32).
# A secret: .env.local (dev) or Symfony Secrets (prod). For a rotation, the old key goes to _PREVIOUS.
CALENDAR_TOKEN_KEY=
CALENDAR_TOKEN_KEY_PREVIOUS=
###< calendar feed ###

###> hosting without worker (docs/DEPLOY_OVH.md) ###
# Secret of POST /api/ops/tick (32 characters at least; empty: the route does not exist). Set it in
# .env.prod.local on a shared host, where an external scheduler calls the tick every minute.
OPS_TICK_TOKEN=
# Handle a few domain events after each write request (shared host without worker): 1 there only.
OPS_DRAIN_ON_TERMINATE=0
###< hosting without worker ###
